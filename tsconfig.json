{
	"compilerOptions": {
		"baseUrl": "./src",
		"paths": {
			"@assets/*": [
				"assets/*"
			],
			"@components/*": [
				"components/*"
			],
			"@hooks/*": [
				"hooks/*"
			],
			"@screens/*": [
				"screens/*"
			],
			"@schemas/*": [
				"schemas/*"
			],
			"@models/*": [
				"models/*"
			],
			"@services/*": [
				"services/*"
			],
			"@utils/*": [
				"utils/*"
			],
			"@config/*": [
				"config/*"
			],
			"@react-query/*": [
				"react-query/*"
			]
		},
		"types": [
			"@types/styled-components-react-native"
		],
		"jsx": "react-jsx",
		"lib": [
			"es2017",
			"dom"
		],
		"target": "es2017",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"allowJs": true,
		"noEmit": true
	},
	"include": [
		"src/**/*",
		"src/@types/index.d.ts"
	],
	"exclude": [
		"node_modules",
		"babel.config.js",
		"metro.config.js"
	]
}