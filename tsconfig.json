{
	"exclude": [
		"__tests__/**/*-test.ts",
		"@tsconfig/react-native/tsconfig.json"
	],
	"compilerOptions": {
		"target": "es6",
		"module": "commonjs",
		"outDir": "./dist",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"allowJs": true,
		"isolatedModules": true,
		"jsx": "react",
		"skipLibCheck": true,
		"strict": true,
		"baseUrl": "./src",
		"paths": {
			"@assets/*": ["assets/*"],
			"@components/*": ["components/*"],
			"@hooks/*": ["hooks/*"],
			"@screens/*": ["screens/*"],
			"@schemas/*": ["schemas/*"],
			"@models/*": ["models/*"],
			"@services/*": ["services/*"],
			"@utils/*": ["utils/*"],
			"@config/*": ["config/*"],
			"@react-query/*": ["react-query/*"]
		}
	}
}
